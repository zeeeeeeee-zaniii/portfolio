# --- Supabase (server-side only, never expose the secret key to the browser) ---
# Project URL, e.g. https://your-project-ref.supabase.co
SUPABASE_URL=
# The project's Secret key (starts with sb_secret_) from Supabase → Settings → API Keys
SUPABASE_SECRET_KEY=

# --- Admin panel ---
# Passcode for the /admin page. Choose something long and private.
ADMIN_PASSCODE=

# --- Live Demo links for the Work section ---
# Full URL of each deployed demo. Leave empty to show "Live Demo — coming soon".
NEXT_PUBLIC_DEMO_BOOKING_URL=
NEXT_PUBLIC_DEMO_BUSINESS_URL=
NEXT_PUBLIC_DEMO_ORDERING_URL=
NEXT_PUBLIC_DEMO_LANDING_URL=
